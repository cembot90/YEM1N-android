<?xml version="1.0" encoding="utf-8"?>
<!--
   Regeln für die automatische Sicherung bis Android 11.
   Fortschritt und Arbeiten werden gesichert. Nicht gesichert wird, was auf einem neuen Gerät nicht mehr gilt
   oder sich neu laden lässt: die Push-Kennung, die Anmeldung bei CloudKit und die heruntergeladenen Stimmen.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="push.xml" />
    <exclude domain="file" path="cloud-anmeldung.txt" />
    <exclude domain="file" path="stimmen" />
</full-backup-content>
